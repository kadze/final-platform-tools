{
  "title": "Cluster Overview",
  "uid": "cluster-overview",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Node CPU Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 - (avg by(instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 2,
      "title": "Node Memory Usage %",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "100 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes * 100)",
        "legendFormat": "{{instance}}"
      }]
    },
    {
      "id": 3,
      "title": "Pod Count by Namespace",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 0, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "count by(namespace) (kube_pod_info)",
        "legendFormat": "{{namespace}}"
      }]
    },
    {
      "id": 4,
      "title": "Pods Not Running",
      "type": "stat",
      "gridPos": { "h": 4, "w": 8, "x": 8, "y": 8 },
      "targets": [{
        "datasource": "Prometheus",
        "expr": "count(kube_pod_status_phase{phase!=\"Running\",phase!=\"Succeeded\"}) or vector(0)",
        "legendFormat": "not running"
      }]
    },
    {
      "id": 5,
      "title": "ALB Request Count (CloudWatch)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "targets": [{
        "datasource": "CloudWatch",
        "dimensions": {},
        "expression": "",
        "highResolution": false,
        "id": "alb_requests",
        "matchExact": true,
        "metricName": "RequestCount",
        "namespace": "AWS/ApplicationELB",
        "period": "60",
        "refId": "A",
        "region": "us-east-1",
        "statistics": ["Sum"]
      }]
    },
    {
      "id": 6,
      "title": "ALB Target Response Time (CloudWatch)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "targets": [{
        "datasource": "CloudWatch",
        "dimensions": {},
        "expression": "",
        "highResolution": false,
        "id": "alb_latency",
        "matchExact": true,
        "metricName": "TargetResponseTime",
        "namespace": "AWS/ApplicationELB",
        "period": "60",
        "refId": "A",
        "region": "us-east-1",
        "statistics": ["Average"]
      }]
    }
  ]
}
